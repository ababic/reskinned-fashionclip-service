{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/ruff_after_edit.py",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/ruff_on_stop.py",
        "timeout": 180,
        "loop_limit": 2
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/ruff_on_stop.py",
        "timeout": 180,
        "loop_limit": 2
      }
    ]
  }
}
